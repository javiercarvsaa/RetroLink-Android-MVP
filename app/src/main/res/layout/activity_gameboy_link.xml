<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gbLinkRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="RetroLink"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Game Boy Link · 2 Jugadores"
                    android:textColor="@color/retro_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtGbLinkStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona CREAR SALA o UNIRSE"
                    android:textColor="@color/retro_cyan"
                    android:textSize="9sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGbLinkBack"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_secondary_neon"
                android:text="←"
                android:textColor="@color/retro_text"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="250dp"
                android:layout_weight="1"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SALA GAME LINK"
                    android:textColor="#B8DAF4"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/txtGbLinkGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Juego seleccionado"
                    android:textColor="@color/retro_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGbLinkNetwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Misma red Wi-Fi/hotspot"
                    android:textColor="@color/retro_muted"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:text="P1 selecciona el juego una sola vez. RetroLink envía y verifica la ROM en P2; después ambos teléfonos abren Gambatte y el Cable Game Link."
                    android:textColor="#789BC0"
                    android:textSize="8sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGbLinkHost"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/btn_primary_gradient"
                        android:text="CREAR SALA · P1"
                        android:textColor="@color/retro_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGbLinkJoin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/btn_secondary_neon"
                        android:text="UNIRSE · P2"
                        android:textColor="@color/retro_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="250dp"
                android:layout_weight="0.82"
                android:layout_marginLeft="10dp"
                android:background="@drawable/hero_neon"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JUGADORES"
                    android:textColor="#B8DAF4"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGbLinkP1"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_glass"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:text="P1 · esperando rol"
                    android:textColor="@color/retro_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGbLinkP2"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/card_glass"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:text="P2 · esperando jugador…"
                    android:textColor="@color/retro_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Máximo: 2 jugadores · Cable Game Link"
                    android:textColor="@color/retro_cyan"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGbLinkLaunch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:alpha="0.42"
                    android:background="@drawable/btn_primary_gradient"
                    android:enabled="false"
                    android:text="SINCRONIZACIÓN AUTOMÁTICA"
                    android:visibility="gone"
                    android:textColor="@color/retro_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
