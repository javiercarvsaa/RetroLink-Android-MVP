<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/atariRoomRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="RetroLink"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atari 2600 · Multiplayer"
                    android:textColor="@color/retro_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAtariRoomStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crea una sala P1 o únete como P2"
                    android:textColor="@color/retro_cyan"
                    android:textSize="9sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAtariRoomBack"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_secondary_neon"
                android:text="←"
                android:textColor="@color/retro_text"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SALA RETROLINK ATARI 2600"
                    android:textColor="#B8DAF4"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAtariRoomGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="P1 selecciona un juego Atari 2600"
                    android:textColor="@color/retro_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAtariRoomNetwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Misma red Wi-Fi/hotspot"
                    android:textColor="@color/retro_muted"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="3dp"
                    android:text="P1 ejecuta Stella y la ROM. P2 no necesita ROM: recibe la pantalla del Host y sus movimientos/FIRE entran como joystick 2."
                    android:textColor="#789BC0"
                    android:textSize="8sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAtariCreateRoom"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/btn_primary_gradient"
                        android:text="CREAR SALA · P1"
                        android:textColor="@color/retro_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAtariJoinRoom"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/btn_secondary_neon"
                        android:text="UNIRSE · P2"
                        android:textColor="@color/retro_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:layout_marginLeft="10dp"
                android:background="@drawable/hero_neon"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JUGADORES"
                    android:textColor="#B8DAF4"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAtariRoomP1"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_glass"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:text="P1 · sala detenida"
                    android:textColor="@color/retro_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAtariRoomP2"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_glass"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:text="P2 · esperando jugador…"
                    android:textColor="@color/retro_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Máximo inicial: P1 + P2&#10;El juego debe soportar un segundo joystick para usar ambos simultáneamente."
                    android:textColor="@color/retro_cyan"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
