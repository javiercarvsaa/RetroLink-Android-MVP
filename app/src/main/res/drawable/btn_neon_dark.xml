<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#D8173447" android:endColor="#D827173B" />
            <corners android:radius="15dp" />
            <stroke android:width="2dp" android:color="#D7FFFFFF" />
            <padding android:left="10dp" android:top="7dp" android:right="10dp" android:bottom="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#E40E1A2C" android:endColor="#E4131027" />
            <corners android:radius="15dp" />
            <stroke android:width="1.5dp" android:color="#7900D8FF" />
            <padding android:left="10dp" android:top="7dp" android:right="10dp" android:bottom="7dp" />
        </shape>
    </item>
</selector>
