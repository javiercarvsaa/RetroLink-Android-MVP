<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon">

    <cl.retrolink.app.DemoGameView android:id="@+id/gameTestView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <!-- Header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌁  Sala local" android:textColor="@color/retro_text" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtHostStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crea una partida en tu red local y juega con tus amigos" android:textColor="@color/retro_cyan" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/card_status_green" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  RetroLink‑Local" android:textColor="@color/retro_text" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtVideoClients" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:text="Red local" android:textColor="@color/retro_green" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Main room -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="236dp" android:layout_marginTop="9dp" android:orientation="horizontal">
                <!-- Players -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/card_cyan_active" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:background="@drawable/pill_green" android:text="P1" android:textColor="@color/retro_cyan" android:textStyle="bold" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="10dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu dispositivo  ♛" android:textColor="@color/retro_text" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/txtP1State" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Conectado · Host" android:textColor="@color/retro_green" android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:background="@drawable/card_magenta_active" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:background="@drawable/pill_status" android:text="P2" android:textColor="@color/retro_magenta" android:textStyle="bold" />
                        <TextView android:id="@+id/txtP2State" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="10dp" android:text="Esperando jugador…" android:textColor="@color/retro_muted" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:background="@drawable/card_purple" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:background="@drawable/pill_status" android:text="P3" android:textColor="#B27BFF" android:textStyle="bold" />
                        <TextView android:id="@+id/txtP3State" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="10dp" android:text="Esperando jugador…" android:textColor="@color/retro_muted" android:textSize="9sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:background="@drawable/card_blue" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:background="@drawable/pill_status" android:text="P4" android:textColor="#7FAFFF" android:textStyle="bold" />
                        <TextView android:id="@+id/txtP4State" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="10dp" android:text="Esperando jugador…" android:textColor="@color/retro_muted" android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Selected game -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:layout_marginLeft="9dp" android:background="@drawable/hero_neon" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JUEGO SELECCIONADO" android:textColor="#B8DAF4" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.16" />
                    <TextView android:id="@+id/txtRomInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Selecciona una ROM N64" android:textColor="@color/retro_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" />
                    <TextView android:id="@+id/txtCoreStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Mupen64Plus‑Next · PresentSync · RetroSR 2.2" android:textColor="#A8C1DF" android:textSize="9sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Grand Prix / aventura / acción\nP1–P4 · red local · controles táctiles y físicos" android:textColor="#789BC0" android:textSize="9sp" android:lineSpacingExtra="3dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                        <Button android:id="@+id/btnRom" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/btn_secondary_neon" android:text="CAMBIAR JUEGO" android:textColor="@color/retro_text" android:textSize="9sp" />
                        <Button android:id="@+id/btnLaunch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:layout_marginLeft="7dp" android:background="@drawable/btn_primary_gradient" android:text="▶  INICIAR PARTIDA" android:textColor="@color/retro_text" android:textSize="10sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Room status -->
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:layout_marginLeft="9dp" android:background="@drawable/card_magenta_active" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SALA ACTIVA" android:textColor="#C8D9ED" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.13" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="RetroLink‑Local" android:textColor="@color/retro_text" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Código de sala\nRL7K3" android:textColor="@color/retro_cyan" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="● Red local\n● BLE controles\n● Wi‑Fi video\n● RetroSR 2.2 Auto Clear" android:textColor="#A8C1DF" android:textSize="9sp" android:lineSpacingExtra="3dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ Todo listo para jugar" android:textColor="@color/retro_green" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="9dp" android:orientation="horizontal">
                <Button android:id="@+id/btnPlayers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:background="@drawable/card_glass" android:text="1P" android:textColor="@color/retro_text" android:textSize="10sp" />
                <Button android:id="@+id/btnViewMode" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="7dp" android:background="@drawable/card_cyan_active" android:text="PANTALLA DISTRIBUIDA" android:textColor="@color/retro_text" android:textSize="9sp" />
                <Button android:id="@+id/btnStartHost" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="7dp" android:background="@drawable/btn_primary_gradient" android:text="ACTIVAR SALA" android:textColor="@color/retro_text" android:textSize="9sp" android:textStyle="bold" />
                <Button android:id="@+id/btnStopHost" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:layout_marginLeft="7dp" android:background="@drawable/card_magenta_soft" android:text="DETENER" android:textColor="@color/retro_text" android:textSize="9sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:layout_marginLeft="7dp" android:background="@drawable/card_glass" android:gravity="center" android:text="RetroSR 2.2\nAUTO CLEAR" android:textColor="@color/retro_cyan" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>


            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/nav_bar" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/navHostHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⌂\nInicio" android:textColor="#A3B8D2" android:textSize="9sp" />
                <TextView android:id="@+id/navHostGames" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▣\nJuegos" android:textColor="#A3B8D2" android:textSize="9sp" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="♟\nSala" android:textColor="@color/retro_cyan" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/navHostProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="◯\nPerfil" android:textColor="#A3B8D2" android:textSize="9sp" />
                <TextView android:id="@+id/navHostSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⚙\nAjustes" android:textColor="#A3B8D2" android:textSize="9sp" />
            </LinearLayout>        </LinearLayout>
    </ScrollView>
</FrameLayout>
