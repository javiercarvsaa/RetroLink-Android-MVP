<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gbLibraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="54dp" android:layout_height="54dp" android:src="@mipmap/ic_launcher" android:contentDescription="RetroLink" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Game Boy / Game Boy Color" android:textColor="@color/retro_text" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RetroLink MultiPlatform · Gambatte" android:textColor="@color/retro_cyan" android:textSize="9sp" />
            </LinearLayout>
            <TextView android:id="@+id/txtGbCount" android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/card_glass" android:gravity="center" android:paddingLeft="16dp" android:paddingRight="16dp" android:text="0 juegos" android:textColor="@color/retro_text" android:textSize="9sp" android:textStyle="bold" />
            <Button android:id="@+id/btnGbImport" android:layout_width="138dp" android:layout_height="42dp" android:layout_marginLeft="8dp" android:background="@drawable/btn_primary_gradient" android:text="＋ IMPORTAR ROM" android:textColor="@color/retro_text" android:textSize="8sp" android:textStyle="bold" />
            <Button android:id="@+id/btnGbBack" android:layout_width="48dp" android:layout_height="42dp" android:layout_marginLeft="8dp" android:background="@drawable/btn_secondary_neon" android:text="←" android:textColor="@color/retro_text" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/txtGbCoverStatus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/card_glass" android:gravity="center_vertical" android:paddingLeft="14dp" android:text="Carátulas GB/GBC · búsqueda automática" android:textColor="#8BB3D8" android:textSize="8sp" />
            <Button android:id="@+id/btnGbRefreshCovers" android:layout_width="122dp" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:background="@drawable/btn_secondary_neon" android:text="↻ CARÁTULAS" android:textColor="@color/retro_text" android:textSize="7sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.7" android:minHeight="300dp" android:background="@drawable/card_glass" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BIBLIOTECA GB / GBC" android:textColor="#B8DAF4" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <GridLayout android:id="@+id/gbRomGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:columnCount="2" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="300dp" android:layout_weight="1" android:layout_marginLeft="10dp" android:background="@drawable/hero_neon" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JUEGO SELECCIONADO" android:textColor="#B8DAF4" android:textSize="8sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="7dp" android:orientation="horizontal">
                    <ImageView android:id="@+id/imgGbSelectedCover" android:layout_width="92dp" android:layout_height="132dp" android:background="@drawable/card_blue" android:contentDescription="Carátula Game Boy" android:src="@mipmap/ic_launcher" android:scaleType="centerInside" android:alpha="0.30" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="10dp" android:orientation="vertical">
                        <TextView android:id="@+id/txtGbTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:text="Selecciona una ROM .gb / .gbc" android:textColor="@color/retro_text" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtGbMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Game Boy / Game Boy Color" android:textColor="@color/retro_muted" android:textSize="9sp" />
                        <TextView android:id="@+id/txtGbState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="○ SIN JUEGO SELECCIONADO" android:textColor="@color/retro_green" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Gambatte ARM64 · ruta software segura&#10;A/B · START · SELECT · gamepad Android" android:textColor="#789BC0" android:textSize="8sp" android:lineSpacingExtra="3dp" />
                <Button android:id="@+id/btnGbPlay" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/btn_primary_gradient" android:text="▶ JUGAR" android:textColor="@color/retro_text" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
