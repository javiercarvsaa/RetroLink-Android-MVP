<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optimizerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnOptimizerBack"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_secondary_neon"
                android:text="←"
                android:textColor="@color/retro_text"
                android:textSize="18sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RetroLink Adaptive Core"
                    android:textColor="@color/retro_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estabilidad primero · optimización local y reversible"
                    android:textColor="@color/retro_cyan"
                    android:textSize="10sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_status_green"
                android:padding="9dp"
                android:text="v1.5 · RULE ENGINE"
                android:textColor="#BFD8F1"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/card_magenta_active"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERFIL ADAPTATIVO"
                    android:textColor="@color/retro_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnOptimizerMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_primary_gradient"
                    android:text="MODO · AUTOMÁTICO"
                    android:textColor="@color/retro_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Automático · Rendimiento · Equilibrado · Calidad · Ahorro de batería · Desactivado"
                    android:textColor="#9CB6D0"
                    android:textSize="9sp" />
                <Switch
                    android:id="@+id/swOptimizerCalibration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Calibración pasiva de 8 s"
                    android:textColor="@color/retro_text"
                    android:textSize="10sp" />
                <Switch
                    android:id="@+id/swOptimizerTemporal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PS1 temporal experimental"
                    android:textColor="@color/retro_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1.25"
                android:background="@drawable/card_blue"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAPACIDAD DETECTADA"
                    android:textColor="@color/retro_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtOptimizerCapabilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_glass"
                    android:padding="12dp"
                    android:text="CPU · RAM · GLES · Vulkan · Hz · térmico"
                    android:textColor="@color/retro_text"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/txtOptimizerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Motor actual: reglas verificables."
                    android:textColor="#9CB6D0"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_glass"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTECCIONES"
                android:textColor="@color/retro_magenta"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="• Nunca cambia la velocidad lógica ni el audio.\n• No modifica controles, guardados, ROM, BIOS ni red Ad Hoc.\n• Bajo carga o temperatura, baja calidad en el siguiente inicio y desactiva primero efectos opcionales.\n• SNES y Atari 2600 conservan pixel art sin filtrado borroso.\n• Todos los perfiles y métricas permanecen en el teléfono."
                android:textColor="#AFC5DB"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnOptimizerResetProfiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_secondary_neon"
                android:text="↻ RESTAURAR PERFILES ESTABLES"
                android:textColor="@color/retro_text"
                android:textSize="9sp" />
            <Button
                android:id="@+id/btnOptimizerDone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary_gradient"
                android:text="✓ GUARDAR Y VOLVER"
                android:textColor="@color/retro_text"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
