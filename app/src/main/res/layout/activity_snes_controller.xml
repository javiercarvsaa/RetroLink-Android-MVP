<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snesControllerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:splitMotionEvents="true">

    <cl.retrolink.app.RemoteFrameView
        android:id="@+id/snesRemoteFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btnL"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="64dp"
        android:alpha="0.76"
        android:background="@drawable/btn_overlay"
        android:text="L"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnR"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="64dp"
        android:layout_marginRight="14dp"
        android:alpha="0.76"
        android:background="@drawable/btn_overlay"
        android:text="R"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold" />

    <cl.retrolink.app.VirtualStickView
        android:id="@+id/virtualStick"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnSelect"
        android:layout_width="84dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginRight="96dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.76"
        android:background="@drawable/btn_neon_dark"
        android:text="SELECT"
        android:textColor="@color/retro_text"
        android:textSize="9sp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="84dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginLeft="96dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.76"
        android:background="@drawable/btn_neon_dark"
        android:text="START"
        android:textColor="@color/retro_text"
        android:textSize="9sp" />

    <Button
        android:id="@+id/btnY"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="154dp"
        android:layout_marginBottom="112dp"
        android:alpha="0.78"
        android:background="@drawable/btn_overlay"
        android:text="Y"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnX"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="88dp"
        android:layout_marginBottom="168dp"
        android:alpha="0.78"
        android:background="@drawable/btn_overlay"
        android:text="X"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnB"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="88dp"
        android:layout_marginBottom="48dp"
        android:alpha="0.80"
        android:background="@drawable/btn_overlay"
        android:text="B"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnA"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="106dp"
        android:alpha="0.82"
        android:background="@drawable/btn_overlay"
        android:text="A"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/snesControllerTopBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="62dp"
        android:background="@drawable/panel_neon_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSnesControllerPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PLAYER 2 · SNES"
                android:textColor="@color/retro_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSnesControllerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscando sala…"
                android:textColor="@color/retro_green"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSnesControllerVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Misma red Wi-Fi/hotspot"
                android:textColor="#A9C4DF"
                android:textSize="7sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSnesReconnect"
            android:layout_width="96dp"
            android:layout_height="42dp"
            android:background="@drawable/btn_neon_cyan"
            android:text="RECONECTAR"
            android:textColor="@color/retro_text"
            android:textSize="7sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSnesRemoteExit"
            android:layout_width="76dp"
            android:layout_height="42dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/btn_neon_magenta"
            android:text="SALIR"
            android:textColor="@color/retro_text"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSnesControllerHud"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="9dp"
        android:layout_marginRight="9dp"
        android:background="@drawable/btn_neon_dark"
        android:text="×"
        android:textColor="@color/retro_text"
        android:textSize="18sp" />
</FrameLayout>
