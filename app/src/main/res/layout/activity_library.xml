<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/libraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_neon"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/btnLibraryBack" android:layout_width="48dp" android:layout_height="44dp" android:background="@drawable/btn_secondary_neon" android:text="←" android:textColor="@color/retro_text" android:textSize="18sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="12dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Biblioteca" android:textColor="@color/retro_text" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tus juegos retro en un solo lugar" android:textColor="@color/retro_cyan" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/card_status_green" android:text="●  Dispositivo listo · RetroLink local" android:textColor="#BFD8F1" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:orientation="horizontal">
            <TextView android:layout_width="110dp" android:layout_height="match_parent" android:background="@drawable/segment_selected" android:gravity="center" android:text="▦  Todos" android:textColor="@color/retro_text" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:layout_width="110dp" android:layout_height="match_parent" android:layout_marginLeft="7dp" android:background="@drawable/card_glass" android:gravity="center" android:text="♡  Favoritos" android:textColor="#B5C7DF" android:textSize="10sp" />
            <TextView android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginLeft="7dp" android:background="@drawable/card_glass" android:gravity="center" android:text="N64" android:textColor="#B5C7DF" android:textSize="10sp" />
            <TextView android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginLeft="7dp" android:background="@drawable/card_glass" android:gravity="center" android:text="SNES" android:textColor="#6E87A8" android:textSize="10sp" />
            <TextView android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginLeft="7dp" android:background="@drawable/card_glass" android:gravity="center" android:text="Arcade" android:textColor="#6E87A8" android:textSize="10sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="12dp" android:background="@drawable/card_glass" android:gravity="center_vertical" android:paddingLeft="16dp" android:text="⌕  Buscar juegos…                                      Ordenar: Recientes" android:textColor="#7998BC" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.45" android:background="@drawable/hero_neon" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROM SELECCIONADA" android:textColor="#B8DAF4" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <TextView android:id="@+id/txtLibraryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Juego N64" android:textColor="@color/retro_text" android:textSize="20sp" android:textStyle="bold" android:maxLines="2" />
                <TextView android:id="@+id/txtLibraryMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="N64 · ROM externa" android:textColor="#A7BEDA" android:textSize="10sp" android:maxLines="3" />
                <TextView android:id="@+id/txtLibraryStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="● LISTO PARA JUGAR" android:textColor="@color/retro_green" android:textSize="10sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:orientation="horizontal">
                    <Button android:id="@+id/btnLibraryPlay" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1.3" android:background="@drawable/btn_primary_gradient" android:text="▶  JUGAR" android:textColor="@color/retro_text" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnLibraryImport" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:background="@drawable/btn_secondary_neon" android:text="＋  IMPORTAR ROM" android:textColor="@color/retro_text" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:layout_marginLeft="10dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/card_cyan_active" android:gravity="center_vertical" android:paddingLeft="18dp" android:text="N64\nNúcleo integrado\nMupen64Plus‑Next" android:textColor="@color/retro_text" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnLibraryHost" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:background="@drawable/card_purple" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingLeft="18dp" android:text="HOST LOCAL\nCrear sala multijugador     ›" android:textColor="@color/retro_text" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:layout_marginLeft="10dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/card_magenta_active" android:gravity="center_vertical" android:paddingLeft="18dp" android:text="RetroSR 2.2\nAUTO CLEAR\nCero historia al girar" android:textColor="@color/retro_text" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnLibraryFavorite" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:background="@drawable/card_glass" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingLeft="18dp" android:text="♡  FAVORITOS\nGestiona tu biblioteca" android:textColor="#B9CBE0" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/nav_bar" android:gravity="center" android:orientation="horizontal">
            <TextView android:id="@+id/navLibraryHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⌂\nInicio" android:textColor="#A3B8D2" android:textSize="9sp" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣\nJuegos" android:textColor="@color/retro_cyan" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/navLibraryRoom" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="♟\nSala" android:textColor="#A3B8D2" android:textSize="9sp" />
            <TextView android:id="@+id/navLibraryProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="◯\nPerfil" android:textColor="#A3B8D2" android:textSize="9sp" />
            <TextView android:id="@+id/navLibrarySettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⚙\nAjustes" android:textColor="#A3B8D2" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
