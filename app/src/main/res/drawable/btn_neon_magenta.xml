<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D9771A73" android:endColor="#D9B11A78" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <padding android:left="10dp" android:top="7dp" android:right="10dp" android:bottom="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#A548184F" android:endColor="#A56F1558" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#CFFF36C7" />
            <padding android:left="10dp" android:top="7dp" android:right="10dp" android:bottom="7dp" />
        </shape>
    </item>
</selector>
