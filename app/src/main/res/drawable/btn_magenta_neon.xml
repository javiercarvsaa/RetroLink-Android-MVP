<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#B05A164D"/><corners android:radius="16dp"/><stroke android:width="2dp" android:color="#FFFFFFFF"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#75281762" android:endColor="#873A104D"/><corners android:radius="16dp"/><stroke android:width="2dp" android:color="#CCFF36C7"/></shape>
    </item>
</selector>
